<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🚧 Baustellen-Seite</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Roboto&display=swap" rel="stylesheet">
  <style>
    body {
      background-color: #FFD300;
      color: #222;
      font-family: "Roboto", sans-serif;
      margin: 0;
      padding: 0;
      text-align: center;
    }

    /* --- Blinkendes Warnlicht --- */
    .warning-light {
      width: 50px;
      height: 50px;
      background-color: orange;
      border-radius: 50%;
      box-shadow: 0 0 15px 4px orange;
      margin: 30px auto 10px;
      animation: blink 1s infinite alternate;
    }

    @keyframes blink {
      from { opacity: 0.3; }
      to { opacity: 1; }
    }

    /* --- Absperrbänder --- */
    .warning-tape {
      width: 100%;
      height: 40px;
      background: repeating-linear-gradient(-45deg, #000 0 20px, #FFD300 20px 40px);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
      z-index: 10;
    }

    .warning-tape:nth-of-type(1) { transform: rotate(-2deg); }
    .warning-tape:nth-of-type(2) { transform: rotate(2deg); }

    /* --- Info-Bereich --- */
    .info-container {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin: 20px auto;
      max-width: 900px;
    }

    .info-box {
      background-color: #fff3b0;
      border: 2px solid #000;
      border-radius: 8px;
      padding: 15px;
      width: 70%;
      max-width: 360px;
      box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }

    /* --- Warnschilder --- */
    .warnschild {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      background: linear-gradient(135deg, #ffbb00, #ffdd55);
      border: 4px solid #000;
      border-radius: 12px;
      padding: 12px;
      width: 180px;
      box-shadow: 3px 3px 8px rgba(0,0,0,0.3);
    }

    .warnschild img {
      width: 100px;
      height: auto;
      display: block;
      margin-bottom: 8px;
    }

    .warnschild .text {
      color: #000;
      font-weight: bold;
      text-align: center;
      line-height: 1.2;
    }

    .warnschild .text .title {
      font-size: 1.1em;
      margin-bottom: 4px;
    }

    .warnschild .text .subtitle {
      font-size: 0.95em;
    }

    /* --- Haupttext --- */
    h1 {
      font-family: "Bebas Neue", sans-serif;
      font-size: 2em;
      margin: 15px 0 5px;
      letter-spacing: 1px;
    }

    p {
      font-family: "Roboto", sans-serif;
      font-size: 1em;
      margin: 5px 0 20px;
    }

    /* --- Bagger Animation --- */
    .excavator {
      position: relative;
      width: 160px;
      height: 100px;
      margin: 40px auto;
      animation: drive 10s linear infinite;
    }

    .cab {
      position: absolute;
      width: 70px;
      height: 50px;
      background: #ffcc00;
      border: 3px solid #000;
      border-radius: 10px 10px 0 0;
      left: 25px;
      top: 10px;
    }

    .arm {
      position: absolute;
      left: 90px;
      top: 25px;
      transform-origin: left center;
      animation: armMove 3s ease-in-out infinite alternate;
    }

    .boom {
      position: absolute;
      width: 50px;
      height: 10px;
      background: #ffaa00;
      border: 2px solid #000;
      transform-origin: left center;
      transform: rotate(-20deg);
    }

    .stick {
      position: absolute;
      left: 45px;
      top: 2px;
      width: 40px;
      height: 8px;
      background: #ff8800;
      border: 2px solid #000;
      transform-origin: left center;
      transform: rotate(30deg);
      animation: stickMove 3s ease-in-out infinite alternate;
    }

    .bucket {
      position: absolute;
      left: 80px;
      top: 8px;
      width: 20px;
      height: 20px;
      background: #333;
      border-radius: 0 0 5px 5px;
      border: 2px solid #000;
      transform-origin: top left;
      transform: rotate(40deg);
      animation: bucketMove 3s ease-in-out infinite alternate;
    }

    .track {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 160px;
      height: 28px;
      background: repeating-linear-gradient(90deg, #000 0 12px, #555 12px 24px);
      border-radius: 20px;
      border: 3px solid #000;
    }

    @keyframes drive {
      0% { transform: translateX(-200px); }
      100% { transform: translateX(100vw); }
    }

    @keyframes armMove { from { transform: rotate(-10deg); } to { transform: rotate(20deg); } }
    @keyframes stickMove { from { transform: rotate(20deg); } to { transform: rotate(60deg); } }
    @keyframes bucketMove { from { transform: rotate(30deg); } to { transform: rotate(60deg); } }

    /* --- MOBILE OPTIMIERUNG --- */
    @media (max-width: 700px) {
      .warnschild {
        width: 140px;
        padding: 8px;
      }
      .warnschild img {
        width: 80px;
      }
      .info-box {
        width: 90%;
        max-width: none;
      }
      h1 {
        font-size: 1.6em;
      }
      p {
        font-size: 0.95em;
      }
      .excavator {
        transform: scale(0.8);
        animation-duration: 14s;
      }
    }

    @media (max-width: 450px) {
      .info-container {
        flex-direction: column;
        align-items: center;
      }
      .warnschild {
        width: 160px;
        margin-bottom: 10px;
      }
      .info-box {
        width: 95%;
      }
      h1 {
        font-size: 1.4em;
      }
    }

  </style>
</head>
<body>

  <!-- Absperrbänder oben -->
  <div class="warning-tape"></div>
  <div class="warning-tape"></div>

